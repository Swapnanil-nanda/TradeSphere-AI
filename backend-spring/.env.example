# ==============================================================================
# TradeSphere AI Backend - Production Environment Variables Example
# Required for Render Web Service + Neon PostgreSQL
# ==============================================================================

# Application Profile
SPRING_PROFILES_ACTIVE=prod

# Server Port (Render sets this dynamically)
PORT=8080

# Neon PostgreSQL Connection URL
# Neon URI format (handled automatically by TradeSphere's normalizer):
# postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
# Or standard Spring JDBC format:
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-your-database-endpoint.us-east-2.aws.neon.tech:5432/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_secure_neon_password

# JWT Authentication Secret (MUST be at least 256 bits / 32 characters hex or base64)
# Generate via: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of Vercel production domains)
CORS_ALLOWED_ORIGINS=https://tradesphere-ai.vercel.app,https://*.vercel.app,http://localhost:3000

# Hikari Connection Pool Tuning for Neon Serverless
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2

# Documentation
SWAGGER_ENABLED=false
