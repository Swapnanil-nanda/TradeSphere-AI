# ==============================================================================
# TradeSphere AI Frontend - Production Environment Variables Example
# Required for Vercel Deployment
# ==============================================================================

# Public Backend API Base URL (e.g. Render Web Service URL)
# Example: https://tradesphere-backend.onrender.com
NEXT_PUBLIC_API_URL=https://tradesphere-backend.onrender.com

# Optional: Server-side internal rewrite target for Next.js API proxying
BACKEND_INTERNAL_URL=https://tradesphere-backend.onrender.com
